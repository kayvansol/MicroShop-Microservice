{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://Consul2:8000"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "spring": {
    "application": {
      "name": "api-gateway"
    }
  },
  "steeltoe": {
    "client": {
      "consul": {
        "discovery": {
          "host": "Consul1",
          "port": 8500,
          "scheme": "http",

          "register": false,
          "serviceName": "api-gateway",

          "healthCheckPath": "/health",
          "healthCheckInterval": "10s",

          //"serviceHost": "192.168.56.165",
          //"servicePort": 8000,

          "useNetUtils": false
        }
      }
    }
  },
  "RoutesFile": "ocelot.Consul.json"
}
